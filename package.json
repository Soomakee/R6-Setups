{
  "name": "r6-lineup-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "R6 Setups — a lineup tracker for Rainbow Six Siege operators, maps, and bomb sites.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app:dev": "concurrently -k \"vite --port 5199 --strictPort\" \"wait-on tcp:127.0.0.1:5199 && cross-env VITE_DEV_SERVER_URL=http://localhost:5199/ electron .\"",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win nsis --dir"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
